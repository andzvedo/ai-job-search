3cb7_51","typename":"Paragraph"}],"__typename":"RichText"},"Paragraph:19c29e6d3cb7_0":{"id":"19c29e6d3cb7_0","name":"16b9","type":"H3","href":null,"layout":null,"metadata":null,"text":"Fundamentals of Layout in Interface Design (UI)","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_1":{"id":"19c29e6d3cb7_1","name":"2532","type":"H4","href":null,"layout":null,"metadata":null,"text":"Composition, balance and how to manage a good structure","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_2":{"id":"19c29e6d3cb7_2","name":"4e05","type":"IMG","href":null,"layout":"OUTSET_CENTER","metadata":{"type":"id","generated":false,"id":"ImageMetadata:1*Y7WghHlExC3_5EHTUF5mhg.png","typename":"ImageMetadata"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*Y7WghHlExC3_5EHTUF5mhg.png":{"id":"1*Y7WghHlExC3_5EHTUF5mhg.png","originalHeight":1080,"originalWidth":1800,"focusPercentX":null,"focusPercentY":null,"alt":null,"__typename":"ImageMetadata"},"Paragraph:19c29e6d3cb7_3":{"id":"19c29e6d3cb7_3","name":"d9aa","type":"P","href":null,"layout":null,"metadata":null,"text":"The layout is the estructure that supports the visual components of an interface. It works opening the paths where the sight can shift to group, prioritize and make sense of the information. It also helps the content to highlight what is the most important data on the site. The layout function, therefore, is invisible to the user but relevant to navigation.","hasDropCap":true,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_4":{"id":"19c29e6d3cb7_4","name":"c865","type":"P","href":null,"layout":null,"metadata":null,"text":"A good layout design is related to objectives, reflected in a good user experience. That is why we can say that a correct layout makes the user find quickly what he is looking for. This is also reflected in more task accomplishment and more time on the site (engagement).","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_5":{"id":"19c29e6d3cb7_5","name":"750b","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"type":"id","generated":false,"id":"ImageMetadata:1*P8GVZ-QUgZ6CsOpFK_4ADQ.png","typename":"ImageMetadata"},"text":"In figure 1, the background and the elements are proportionally equal. In figure 2, the background does not exist so the elements become a solid block. In figure 3, two lines are removed making the negative space very evident to the eye. This spacing of the elements is the base for the construction of a layout.","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*P8GVZ-QUgZ6CsOpFK_4ADQ.png":{"id":"1*P8GVZ-QUgZ6CsOpFK_4ADQ.png","originalHeight":376,"originalWidth":2160,"focusPercentX":null,"focusPercentY":null,"alt":null,"__typename":"ImageMetadata"},"Paragraph:19c29e6d3cb7_6":{"id":"19c29e6d3cb7_6","name":"5b67","type":"P","href":null,"layout":null,"metadata":null,"text":"A well applied spacing helps to focus in content, reduces distractions and improves page scan-ability, also defines categories and gives logical meaning to the user’s mental processes. By developing this with a creative and dynamic layout, you get a usable but also esthetic UI design.","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_7":{"id":"19c29e6d3cb7_7","name":"dd74","type":"P","href":null,"layout":null,"metadata":null,"text":"To create a layout we must know about the principles of proximity and negative space, both explained in the article Fundamentals of Hierarchy in Interface Design. In this study we will present seven resources for the professional creation of a standing layout.","hasDropCap":null,"dropCapImage":null,"markups":[{"type":"id","generated":true,"id":"Paragraph:19c29e6d3cb7_7.markups.0","typename":"Markup"},{"type":"id","generated":true,"id":"Paragraph:19c29e6d3cb7_7.markups.1","typename":"Markup"}],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_7.markups.0":{"type":"A","start":116,"end":161,"href":"https:\u002F\u002Fmedium.com\u002Fswlh\u002Ffundamentals-of-hierarchy-in-interface-design-ui-ba8e3017dceb","anchorType":"LINK","userId":null,"linkMetadata":null,"__typename":"Markup"},"Paragraph:19c29e6d3cb7_7.markups.1":{"type":"STRONG","start":115,"end":161,"href":null,"anchorType":null,"userId":null,"linkMetadata":null,"__typename":"Markup"},"Paragraph:19c29e6d3cb7_8":{"id":"19c29e6d3cb7_8","name":"c70c","type":"H3","href":null,"layout":null,"metadata":null,"text":"Size","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_9":{"id":"19c29e6d3cb7_9","name":"cd67","type":"P","href":null,"layout":null,"metadata":null,"text":"Size hierarchy facilitates the user’s decision. Size is the clearest way to inform the user what is important in a site, that is why the homepage layouts usually have hierarchical blocks of information.","hasDropCap":null,"dropCapImage":null,"markups":[{"type":"id","generated":true,"id":"Paragraph:19c29e6d3cb7_9.markups.0","typename":"Markup"}],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_9.markups.0":{"type":"STRONG","start":0,"end":47,"href":null,"anchorType":null,"userId":null,"linkMetadata":null,"__typename":"Markup"},"Paragraph:19c29e6d3cb7_10":{"id":"19c29e6d3cb7_10","name":"c28f","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"type":"id","generated":false,"id":"ImageMetadata:1*KycqkBUBoylqan2Ueg4K5Q.png","typename":"ImageMetadata"},"text":"In this screenshot from The New Yorker, the size hierarchy is revealed in several of the blocks that make up the layout. The news “The fate of the news …” is clearly the news that the user will perceive as main, followed by the blocks on the left and then on the right.","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*KycqkBUBoylqan2Ueg4K5Q.png":{"id":"1*KycqkBUBoylqan2Ueg4K5Q.png","originalHeight":646,"originalWidth":1068,"focusPercentX":null,"focusPercentY":null,"alt":null,"__typename":"ImageMetadata"},"Paragraph:19c29e6d3cb7_11":{"id":"19c29e6d3cb7_11","name":"6e21","type":"P","href":null,"layout":null,"metadata":null,"text":"The current traditional navigation scheme could be divided into two types, the navigation pages and the consumer pages. Typically, when a user enters a website’s home page, they have a navigation provision, either to discover content or to search for something specific. This is the reason for creating hierarchy blocks, which function as doors for all interface content.","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_12":{"id":"19c29e6d3cb7_12","name":"bd57","type":"P","href":null,"layout":null,"metadata":null,"text":"On the other hand, when the user has found what they are looking for and clicks on one block, what they need now is to consume the content, making the hierarchies less relevant within this page. In this scenario, the most functional and friendly design is to display the information in a balanced way to facilitate the natural reading of sight. Everything has to do with the objective of each page.","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_13":{"id":"19c29e6d3cb7_13","name":"bbea","type":"H3","href":null,"layout":null,"metadata":null,"text":"Visual Journey","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_14":{"id":"19c29e6d3cb7_14","name":"b0e2","type":"P","href":null,"layout":null,"metadata":null,"text":"Being aware of the visual journey gives you the power to manipulate it. Guiding the view along a suggested path is much friendlier than forcing items to be scanned, therefore the visual journey must be known in the design.","hasDropCap":null,"dropCapImage":null,"markups":[{"type":"id","generated":true,"id":"Paragraph:19c29e6d3cb7_14.markups.0","typename":"Markup"}],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_14.markups.0":{"type":"STRONG","start":0,"end":72,"href":null,"anchorType":null,"userId":null,"linkMetadata":null,"__typename":"Markup"},"Paragraph:19c29e6d3cb7_15":{"id":"19c29e6d3cb7_15","name":"a3c6","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"type":"id","generated":false,"id":"ImageMetadata:1*HnqbcHuKPvWW10h-B6g0BA@2x.jpeg","typename":"ImageMetadata"},"text":"In this screenshot of a movie detail on Netflix, the visual weight starts on the movie poster, then the view jumps to the red Play button. For users who need more, the view receives the description of the film and the four actions represented in iconographies. The tour ends with the actors, information under the poster, and recommendations from other films.","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*HnqbcHuKPvWW10h-B6g0BA@2x.jpeg":{"id":"1*HnqbcHuKPvWW10h-B6g0BA@2x.jpeg","originalHeight":1334,"originalWidth":750,"focusPercentX":null,"focusPercentY":null,"alt":null,"__typename":"ImageMetadata"},"Paragraph:19c29e6d3cb7_16":{"id":"19c29e6d3cb7_16","name":"1f14","type":"P","href":null,"layout":null,"metadata":null,"text":"It is very common to start designing with the false perception that all the elements must attract attention, but designing without any order of priority results in lack of clarity and a lot of noise in communication. Although it is difficult to make these decisions, especially in small spaces such as a smartphone screen, having the following considerations could facilitate the process:","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_17":{"id":"19c29e6d3cb7_17","name":"c446","type":"P","href":null,"layout":null,"metadata":null,"text":"Know the information, understand what the content is about, the objective of the page and what elements will be included.","hasDropCap":null,"dropCapImage":null,"markups":[{"type":"id","generated":true,"id":"Paragraph:19c29e6d3cb7_17.markups.0","typename":"Markup"}],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_17.markups.0":{"type":"STRONG","start":0,"end":20,"href":null,"anchorType":null,"userId":null,"linkMetadata":null,"__typename":"Markup"},"Paragraph:19c29e6d3cb7_18":{"id":"19c29e6d3cb7_18","name":"c459","type":"P","href":null,"layout":null,"metadata":null,"text":"Consciously diagram the content, create a layout and start making alternate versions based on the established priority order.","hasDropCap":null,"dropCapImage":null,"markups":[{"type":"id","generated":true,"id":"Paragraph:19c29e6d3cb7_18.markups.0","typename":"Markup"}],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_18.markups.0":{"type":"STRONG","start":0,"end":33,"href":"","anchorType":"LINK","userId":"","linkMetadata":null,"__typename":"Markup"},"Paragraph:19c29e6d3cb7_19":{"id":"19c29e6d3cb7_19","name":"e85e","type":"P","href":null,"layout":null,"metadata":null,"text":"Verify the visual journey from time to time, because going back to the design with ‘fresh eyes’ is a great way to recognize better opportunities to improve the layout and the visual path.","hasDropCap":null,"dropCapImage":null,"markups":[{"type":"id","generated":true,"id":"Paragraph:19c29e6d3cb7_19.markups.0","typename":"Markup"}],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_19.markups.0":{"type":"STRONG","start":0,"end":45,"href":null,"anchorType":null,"userId":null,"linkMetadata":null,"__typename":"Markup"},"Paragraph:19c29e6d3cb7_20":{"id":"19c29e6d3cb7_20","name":"baad","type":"H3","href":null,"layout":null,"metadata":null,"text":"Asymmetry","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_21":{"id":"19c29e6d3cb7_21","name":"3a25","type":"P","href":null,"layout":null,"metadata":null,"text":"Asymmetric layouts express more movement and dynamism. Asymmetry tends to be more expressing to the eye due to the laws of composition and balance, it facilitates the hierarchy of the elements and provides them with movement.","hasDropCap":null,"dropCapImage":null,"markups":[{"type":"id","generated":true,"id":"Paragraph:19c29e6d3cb7_21.markups.0","typename":"Markup"}],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_21.markups.0":{"type":"STRONG","start":0,"end":54,"href":null,"anchorType":null,"userId":null,"linkMetadata":null,"__typename":"Markup"},"Paragraph:19c29e6d3cb7_22":{"id":"19c29e6d3cb7_22","name":"a6a5","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"type":"id","generated":false,"id":"ImageMetadata:1*W_xC1yDr_FcUpvGS6abesw.jpeg","typename":"ImageMetadata"},"text":"The CSS Design Awards main page shows an interesting example of asymmetric composition. To balance the fact that the main block on the left is not centered relatively to the screen, several higher contrast elements are used on the right.","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*W_xC1yDr_FcUpvGS6abesw.jpeg":{"id":"1*W_xC1yDr_FcUpvGS6abesw.jpeg","originalHeight":646,"originalWidth":1068,"focusPercentX":null,"focusPercentY":null,"alt":null,"__typename":"ImageMetadata"},"Paragraph:19c29e6d3cb7_23":{"id":"19c29e6d3cb7_23","name":"6514","type":"P","href":null,"layout":null,"metadata":null,"text":"The main idea is to balance the interface elements in such a way that one part does not weigh more than the other, but without being strictly obvious as in symmetry designs. This forces us to define a hierarchy in the layout and to play with elements such as texts, icons, images, spaces and colors in a more creative and standing way.","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_24":{"id":"19c29e6d3cb7_24","name":"d9d5","type":"P","href":null,"layout":null,"metadata":null,"text":"The visual journey of an asymmetric composition goes from the main element to the secondary elements, expressing a certain tension between them and a diversity of emotions that will depend on the style and form of the design. Surrounding the elements with the appropriate negative space is very important in this case. In short, one could say that asymmetry is a hidden symmetry, which is more interesting to the mind.","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_25":{"id":"19c29e6d3cb7_25","name":"5b86","type":"H3","href":null,"layout":null,"metadata":null,"text":"Space","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_26":{"id":"19c29e6d3cb7_26","name":"df90","type":"P","href":null,"layout":null,"metadata":null,"text":"Correct spacing defines the layout. Since the layout is evidenced by the spacing between elements or negative space, its form depends on how much some elements are closer than others.","hasDropCap":null,"dropCapImage":null,"markups":[{"type":"id","generated":true,"id":"Paragraph:19c29e6d3cb7_26.markups.0","typename":"Markup"}],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_26.markups.0":{"type":"STRONG","start":0,"end":35,"href":"","anchorType":"LINK","userId":"","linkMetadata":null,"__typename":"Markup"},"Paragraph:19c29e6d3cb7_27":{"id":"19c29e6d3cb7_27","name":"a95f","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"type":"id","generated":false,"id":"ImageMetadata:1*UBsYb0Ba06q6p90eiS6lIA@2x.jpeg","typename":"ImageMetadata"},"text":"In the Mimo application you can see the grouping of elements that can make up a layout, the space between the first group (spot illustration and texts) and the second group (the plans) works as a support for the structure. The same happens with the space between the plans, and between the plans and the continue button. In this subtle way, the negative space makes up a layout.","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*UBsYb0Ba06q6p90eiS6lIA@2x.jpeg":{"id":"1*UBsYb0Ba06q6p90eiS6lIA@2x.jpeg","originalHeight":1334,"originalWidth":750,"focusPercentX":null,"focusPercentY":null,"alt":null,"__typename":"ImageMetadata"},"Paragraph:19c29e6d3cb7_28":{"id":"19c29e6d3cb7_28","name":"2efb","type":"P","href":null,"layout":null,"metadata":null,"text":"These spaces contain the composition and connect or disconnect the elements in such a way that associations are created between them. The main visual associations are determined by the layout, so they must be designed for this purpose from the beginning. We should also bear in mind that the distance between one element and another must be a reflection of what the user has in mind as related and unrelated, and that isolate a group of elements gives more legibility and importance. The UI design layout is finally an organization of space.","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_29":{"id":"19c29e6d3cb7_29","name":"0af7","type":"H3","href":null,"layout":null,"metadata":null,"text":"Break","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_30":{"id":"19c29e6d3cb7_30","name":"0181","type":"P","href":null,"layout":null,"metadata":null,"text":"Breaking a traditional scheme holds the user’s attention. The repetition of the forms tends to condition the mind, so the change of scheme always attracts the attention of the user and keep him waiting for more information.","hasDropCap":null,"dropCapImage":null,"markups":[{"type":"id","generated":true,"id":"Paragraph:19c29e6d3cb7_30.markups.0","typename":"Markup"}],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_30.markups.0":{"type":"STRONG","start":0,"end":58,"href":null,"anchorType":null,"userId":null,"linkMetadata":null,"__typename":"Markup"},"Paragraph:19c29e6d3cb7_31":{"id":"19c29e6d3cb7_31","name":"a20a","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"type":"id","generated":false,"id":"ImageMetadata:1*iUoQWErMVu53k71BxAGnBw.jpeg","typename":"ImageMetadata"},"text":"On this airbnb page the photo gallery is displayed in such a way that creates a break in the user’s reading. Photos 1, 2 and 5 have the same dimension, but photos 3 and 4 break the format to make the visual journey more dynamic.","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*iUoQWErMVu53k71BxAGnBw.jpeg":{"id":"1*iUoQWErMVu53k71BxAGnBw.jpeg","originalHeight":646,"originalWidth":1068,"focusPercentX":null,"focusPercentY":null,"alt":null,"__typename":"ImageMetadata"},"Paragraph:19c29e6d3cb7_32":{"id":"19c29e6d3cb7_32","name":"05be","type":"P","href":null,"layout":null,"metadata":null,"text":"Fully focused on attracting attention, the change of the same scheme is linked to the visual law of repetition and alignment, where any element that belongs to a group and that breaks its alienation or other characteristic will be more striking and interesting to the eye.","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_33":{"id":"19c29e6d3cb7_33","name":"9225","type":"P","href":null,"layout":null,"metadata":null,"text":"Many times designing a basic functional layout reduces the designer’s curiosity to find new ways to make the reading of information more fun. But keeping the user’s attention and making the experience exciting has a lot to do with movement, scales, clutter and breaking some rules. The usual is comfortable, but the innovative becomes memorable.","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_34":{"id":"19c29e6d3cb7_34","name":"0a7a","type":"H3","href":null,"layout":null,"metadata":null,"text":"Superposition","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_35":{"id":"19c29e6d3cb7_35","name":"6f4f","type":"P","href":null,"layout":null,"metadata":null,"text":"Overlapping one element on another creates depth. Although the layout lives in a two-dimensional world, placing one element on top of another expanding its depth gives realism to the composition.","hasDropCap":null,"dropCapImage":null,"markups":[{"type":"id","generated":true,"id":"Paragraph:19c29e6d3cb7_35.markups.0","typename":"Markup"}],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_35.markups.0":{"type":"STRONG","start":0,"end":49,"href":null,"anchorType":null,"userId":null,"linkMetadata":null,"__typename":"Markup"},"Paragraph:19c29e6d3cb7_36":{"id":"19c29e6d3cb7_36","name":"629d","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"type":"id","generated":false,"id":"ImageMetadata:1*IFSBZRm51wejYCsnRaXz6w@2x.jpeg","typename":"ImageMetadata"},"text":"This screenshot from the WWF application shows the overlay of the texts: “Sharks”, “Diversity,” “Enter” and the (+) button on the shark image, balancing the flat world of user interface design and the three-dimensional style that graphic design could have.","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*IFSBZRm51wejYCsnRaXz6w@2x.jpeg":{"id":"1*IFSBZRm51wejYCsnRaXz6w@2x.jpeg","originalHeight":1334,"originalWidth":750,"focusPercentX":null,"focusPercentY":null,"alt":null,"__typename":"ImageMetadata"},"Paragraph:19c29e6d3cb7_37":{"id":"19c29e6d3cb7_37","name":"8dd7","type":"P","href":null,"layout":null,"metadata":null,"text":"Using the superposition in UI design creates in users the perception that there is a real stage on the screen. The use of different layers shows that the design continues, extending into space, which not only feels more realistic and absorbing, but also visually more interesting. One of the most important rules when overlapping texts is that there should be enough contrast to the background to avoid readability problems. If the sight cannot fluently recognize the characters, the experience will be stressful.","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_38":{"id":"19c29e6d3cb7_38","name":"4177","type":"H3","href":null,"layout":null,"metadata":null,"text":"Grids","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_39":{"id":"19c29e6d3cb7_39","name":"a4dd","type":"P","href":null,"layout":null,"metadata":null,"text":"The use of the grid is mathematically pleasing to the eye. Although invisible in the design, the grids facilitate the location of the elements, create a proportional distribution and give a high consistency to the interface.","hasDropCap":null,"dropCapImage":null,"markups":[{"type":"id","generated":true,"id":"Paragraph:19c29e6d3cb7_39.markups.0","typename":"Markup"}],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_39.markups.0":{"type":"STRONG","start":0,"end":58,"href":null,"anchorType":null,"userId":null,"linkMetadata":null,"__typename":"Markup"},"Paragraph:19c29e6d3cb7_40":{"id":"19c29e6d3cb7_40","name":"ba80","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"type":"id","generated":false,"id":"ImageMetadata:1*LuJX1aCMEoGhjZOga-6igQ@2x.jpeg","typename":"ImageMetadata"},"text":"In this screenshot of the IMDb app, a grid is used to organize all elements in terms of alignment and size. The proportional consistency is evident and pleasing to the eye.","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*LuJX1aCMEoGhjZOga-6igQ@2x.jpeg":{"id":"1*LuJX1aCMEoGhjZOga-6igQ@2x.jpeg","originalHeight":1334,"originalWidth":750,"focusPercentX":null,"focusPercentY":null,"alt":null,"__typename":"ImageMetadata"},"Paragraph:19c29e6d3cb7_41":{"id":"19c29e6d3cb7_41","name":"ff46","type":"P","href":null,"layout":null,"metadata":null,"text":"Designing with the correct spacing is a real challenge, but maintaining the consistency of this spacing throughout the UI flow is even more challenging. The grid is the standard solution for this. The way it contains the elements will give precise proportion, but we must remember that the layout can vary considerably, depending on the style of the designer and how he wants to display the information. Systematic practice is the best way to master the use of grids.","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_42":{"id":"19c29e6d3cb7_42","name":"ff6e","type":"P","href":null,"layout":null,"metadata":null,"text":"In summary, although there is a great variety of layouts and ways in which information can be distributed, the most important rule is to keep it simple. The vast majority of users are not in an interface by design, but by the information contained in the design. After all, complex structures are difficult to understand.","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_43":{"id":"19c29e6d3cb7_43","name":"5dd4","type":"P","href":null,"layout":null,"metadata":null,"text":"While it is not an easy task to be able to combine esthetic principles and the science of cognitive processes, the correct use of both is essential for professional UI design. If we are going to tackle a new project, let us remember to give ourselves the necessary creative freedom, but always based on a structure that the user recognizes and that has been proven to work.","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_44":{"id":"19c29e6d3cb7_44","name":"a869","type":"P","href":null,"layout":null,"metadata":null,"text":"Thanks for reading.","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_45":{"id":"19c29e6d3cb7_45","name":"8865","type":"P","href":null,"layout":null,"metadata":null,"text":"References:","hasDropCap":null,"dropCapImage":null,"markups":[],"__typename":"Paragraph","iframe":null,"mixtapeMetadata":null},"Paragraph:19c29e6d3cb7_46":{"id":"19c29e6d3cb7_46","name":"881a","type":"OLI","href":null,"layout":null,"metadata":null,"text":"The Elements of Graphic Design by Alex W. White","hasDropCap":null,"dropCapImage":null,"markups":[{"type":"id","generated":true,"id":"Paragraph:19c29e6d3cb7_46.markups.0","typename":"Markup"},{"type":"id","generated":true,"id":"Paragraph:19c29e6d3cb7_46.markups.1","typename":"Markup"}],"__typename":"Paragraph","if